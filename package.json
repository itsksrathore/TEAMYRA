{
  "name": "teamyra",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Local-first multi-agent coding control plane for Claude Code, Codex, Antigravity and embedded ChatGPT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "desktop": "npm --workspace @teamyra/desktop start",
    "desktop:check": "npm --workspace @teamyra/desktop run check",
    "teamyra": "python bridge/teamyra_cli.py",
    "mcp:stdio": "python bridge/teamyra_cli.py mcp stdio",
    "mcp:http": "python bridge/teamyra_cli.py mcp http",
    "core:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-core.ps1",
    "desktop:dist:dir": "npm --workspace @teamyra/desktop run dist:dir",
    "desktop:dist:win": "npm --workspace @teamyra/desktop run dist:win"
  },
  "keywords": [
    "multi-agent",
    "coding-agent",
    "ai-coding",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "antigravity",
    "chatgpt",
    "git-worktree",
    "agent-orchestration",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsksrathore/TEAMYRA.git"
  },
  "bugs": {
    "url": "https://github.com/itsksrathore/TEAMYRA/issues"
  },
  "homepage": "https://github.com/itsksrathore/TEAMYRA#readme"
}
