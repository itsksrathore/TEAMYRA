{
  "name": "@teamyra/desktop",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "TEAMYRA local-first multi-agent coding desktop",
  "author": "TEAMYRA Contributors",
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "esbuild renderer/app.mjs --bundle --platform=browser --format=iife --outfile=renderer/bundle.js",
    "start": "npm run build:renderer && electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/provider-registry.js && node --check src/core-api.js && node --check src/mcp-integration.js && node --check src/chatgpt-session-manager.js && node --check src/chatgpt-automation-adapter.js && node --check src/workspace-bridge.js && node --check src/chatgpt-web-provider.js && node --check renderer/agent-icons.mjs && node --check renderer/app.mjs && node tests/chatgpt-automation-adapter.test.js && node tests/mcp-integration.test.js && node tests/startup-diagnostics.test.js && node tests/workspace-status.test.js",
    "build:core": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-core.ps1",
    "dist:dir": "npm run build:renderer && npm run build:core && electron-builder --dir --win",
    "dist:win": "npm run build:renderer && npm run build:core && electron-builder --win nsis",
    "dist:portable": "npm run build:renderer && npm run build:core && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "43.7.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.teamyra.desktop",
    "productName": "TEAMYRA",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/teamyra-core",
        "to": "teamyra-core"
      },
      {
        "from": "assets/teamyra-icon.ico",
        "to": "teamyra-icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "TEAMYRA-Setup-${version}-${arch}.${ext}",
      "icon": "assets/teamyra-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TEAMYRA",
      "installerIcon": "assets/teamyra-icon.ico",
      "uninstallerIcon": "assets/teamyra-icon.ico",
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "include": "packaging/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "itsksrathore",
        "repo": "TEAMYRA",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "TEAMYRA-${version}-${arch}-Portable.${ext}"
    },
    "afterPack": "packaging/after-pack.cjs"
  }
}
