{
  "name": "@teamyra/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TEAMYRA multi-agent control desk",
  "main": "src/main.js",
  "scripts": {
    "build:renderer": "esbuild renderer/app.mjs --bundle --platform=browser --format=iife --outfile=renderer/bundle.js",
    "start": "npm run build:renderer && electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/provider-registry.js && node --check src/core-api.js && node --check renderer/app.mjs"
  },
  "devDependencies": {
    "electron": "43.7.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
